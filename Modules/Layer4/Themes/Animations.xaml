<!-- Summary: Resource Dictionary containing Storyboard transitions for showing (SlideIn) and hiding (SlideOut) the HUD. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Storyboard x:Key="SlideIn">
        <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                         Storyboard.TargetProperty="Y" 
                         From="-50" To="0" 
                         Duration="0:0:0.2" 
                         DecelerationRatio="0.8"/>
        <DoubleAnimation Storyboard.TargetName="MainBorder" 
                         Storyboard.TargetProperty="Opacity" 
                         From="0" To="1.0" 
                         Duration="0:0:0.18"/>
    </Storyboard>
    
    <Storyboard x:Key="SlideOut">
        <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                         Storyboard.TargetProperty="Y" 
                         To="-50" 
                         Duration="0:0:0.18" 
                         AccelerationRatio="0.8"/>
        <DoubleAnimation Storyboard.TargetName="MainBorder" 
                         Storyboard.TargetProperty="Opacity" 
                         To="0" 
                         Duration="0:0:0.15"/>
    </Storyboard>
</ResourceDictionary>
