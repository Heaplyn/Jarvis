<Window x:Class="JarvisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Jarvis Launcher" 
        Width="680"
        SizeToContent="Height"
        MaxHeight="550"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize" 
        ShowInTaskbar="False" 
        Topmost="True"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <!-- Animations -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                             Storyboard.TargetProperty="Y" 
                             From="-50" To="0" 
                             Duration="0:0:0.2" 
                             DecelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0" To="0.98" 
                             Duration="0:0:0.18"/>
        </Storyboard>
        
        <Storyboard x:Key="SlideOut">
            <DoubleAnimation Storyboard.TargetName="WindowTranslate" 
                             Storyboard.TargetProperty="Y" 
                             To="-50" 
                             Duration="0:0:0.18" 
                             AccelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetName="MainBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             To="0" 
                             Duration="0:0:0.15"/>
        </Storyboard>

        <!-- ListBox Item Styling -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" 
                                CornerRadius="6" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#1C8050E6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#338050E6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#808050E6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="11,9"/> <!-- Adjust padding for border thickness -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <!-- Shadow Container -->
        <Border x:Name="MainBorder" 
                Background="#F2140D24" 
                BorderBrush="#4D8050E6" 
                BorderThickness="1" 
                CornerRadius="12" 
                Opacity="0"
                ClipToBounds="True">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="4"/>
            </Border.Effect>
            
            <Border.RenderTransform>
                <TranslateTransform x:Name="WindowTranslate" Y="-50"/>
            </Border.RenderTransform>
            
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Panel -->
                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchInput" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="#FFFFFF" 
                             FontSize="20" 
                             FontFamily="Segoe UI Semibold, Arial"
                             CaretBrush="#FFD9CCFF" 
                             Padding="6,4"
                             VerticalAlignment="Center"
                             TextChanged="SearchInput_TextChanged"
                             PreviewKeyDown="SearchInput_PreviewKeyDown"/>
                    
                    <TextBlock x:Name="PlaceholderText" 
                               Text="Type a command, math, or app name..." 
                               Foreground="#5AFFFFFF" 
                               FontSize="20" 
                               FontFamily="Segoe UI Semibold, Arial"
                               IsHitTestVisible="False" 
                               Margin="12,4" 
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Divider line -->
                <Separator Grid.Row="1" 
                           Background="#26FFFFFF" 
                           Margin="0,8,0,8" 
                           Height="1"
                           x:Name="DividerLine"
                           Visibility="Collapsed"/>

                <!-- Suggestions Panel -->
                <ListBox Grid.Row="2" 
                         x:Name="ResultsList" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         Visibility="Collapsed"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewKeyDown="ResultsList_PreviewKeyDown">
                    
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="#FFFFFF" 
                                           FontSize="15" 
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding Description}" 
                                           Foreground="#8CFFFFFF" 
                                           FontSize="12" 
                                           Margin="0,2,0,0"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
